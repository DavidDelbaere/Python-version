QDialog { background-color: #1f1f1f; }
QLabel { color: #f2f2f2; }
QPushButton {
    color: #f5f5f5;
    background-color: #3f3f3f;
    border: 1px solid #5a5a5a;
    border-radius: 6px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton:hover { background-color: #525252; }
